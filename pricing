  <script>
    function submitForm() {
      const name   = document.getElementById('field-name').value.trim();
      const email  = document.getElementById('field-email').value.trim();
      const school = document.getElementById('field-school').value.trim();
      const role   = document.getElementById('field-role').value;

      if (!name || !email || !school || !role) {
        alert('Please fill in your name, email, school, and role.');
        return;
      }

      const sports = document.getElementById('field-sports').value.trim();
      const notes  = document.getElementById('field-notes').value.trim();

      const subject = encodeURIComponent(`XSEN Demo Request — ${school}`);
      const body = encodeURIComponent(
        `Name: ${name}\nEmail: ${email}\nSchool/Org: ${school}\nRole: ${role}\nSports: ${sports || 'Not specified'}\n\nNotes:\n${notes || 'None'}`
      );

      window.location.href = `mailto:partner@xsen.fun?subject=${subject}&body=${body}`;

      document.getElementById('contact-form').style.display = 'none';
      document.getElementById('form-success').style.display = 'block';
    }
  </script>

