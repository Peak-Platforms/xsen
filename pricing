<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>XSEN — Get Your School's Channel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --black:       #0a0a0a;
      --dark:        #111111;
      --mid:         #181818;
      --card:        #161616;
      --border:      rgba(255,255,255,0.08);
      --border-gold: rgba(201,168,76,0.3);
      --white:       #f5f5f0;
      --muted:       rgba(245,245,240,0.5);
      --muted-hi:    rgba(245,245,240,0.72);
      --gold:        #c9a84c;
      --gold-dim:    rgba(201,168,76,0.1);
      --red:         #841617;
      --green:       #2a7a4b;
    }

    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      font-family:'DM Sans',sans-serif;
      background:var(--black); color:var(--white);
      line-height:1.6; overflow-x:hidden;
    }

    .label { display:block; font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--gold); margin-bottom:14px; }
    .section-title { font-family:'Bebas Neue',sans-serif; font-size:clamp(34px,5vw,54px); letter-spacing:1px; line-height:1; }
    .gold-x { font-family:'Bebas Neue',sans-serif; color:var(--gold); font-size:1.15em; }

    /* NAV */
    nav {
      position:fixed; top:0; left:0; right:0; z-index:200;
      padding:16px 48px; display:flex; align-items:center; justify-content:space-between;
      background:rgba(10,10,10,0.97); border-bottom:1px solid var(--border);
    }
    .nav-logo { font-family:'Bebas Neue',sans-serif; font-size:26px; letter-spacing:2px; color:var(--white); text-decoration:none; }
    .nav-logo span { color:var(--gold); }
    .nav-links { display:flex; gap:28px; align-items:center; }
    .nav-links a { color:var(--muted); text-decoration:none; font-size:13px; font-weight:600; letter-spacing:0.5px; transition:color 0.2s; }
    .nav-links a:hover { color:var(--white); }
    .nav-cta { background:var(--gold) !important; color:var(--black) !important; padding:8px 20px; border-radius:4px; font-weight:700 !important; font-size:13px !important; }

    /* HERO */
    .hero {
      padding:140px 48px 100px; text-align:center;
      background:radial-gradient(ellipse at center top, rgba(132,22,23,0.15) 0%, transparent 55%);
      border-bottom:1px solid var(--border);
    }
    .hero-eyebrow {
      display:inline-flex; align-items:center; gap:10px;
      border:1px solid var(--border-gold); background:var(--gold-dim);
      padding:6px 18px; border-radius:999px; margin-bottom:28px;
      font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--gold);
    }
    .hero-eyebrow::before { content:''; width:6px; height:6px; border-radius:50%; background:var(--gold); flex-shrink:0; }
    .hero h1 { font-family:'Bebas Neue',sans-serif; font-size:clamp(56px,9vw,108px); line-height:0.9; letter-spacing:2px; margin-bottom:24px; }
    .hero h1 em { font-style:normal; color:var(--gold); }
    .hero-sub { font-size:18px; color:var(--muted-hi); max-width:620px; margin:0 auto 16px; line-height:1.75; }
    .hero-note { font-size:13px; color:var(--muted); margin-bottom:44px; }

    .btn-primary { background:var(--gold); color:var(--black); padding:16px 36px; border-radius:4px; text-decoration:none; font-weight:700; font-size:15px; letter-spacing:0.5px; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; }
    .btn-primary:hover { opacity:0.88; transform:translateY(-1px); box-shadow:0 8px 28px rgba(201,168,76,0.25); }
    .btn-outline { background:transparent; color:var(--white); padding:16px 36px; border-radius:4px; text-decoration:none; font-weight:600; font-size:15px; letter-spacing:0.5px; border:1px solid rgba(255,255,255,0.22); transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; }
    .btn-outline:hover { border-color:rgba(255,255,255,0.55); background:rgba(255,255,255,0.04); }

    .hero-ctas { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
    .hero-price-anchor { display:inline-flex; align-items:center; gap:8px; margin-top:20px; font-size:13px; color:var(--muted); }
    .hero-price-anchor strong { color:var(--gold); font-size:16px; }

    /* BROADCAST HERO - the big differentiator */
    .broadcast-section { padding:100px 48px; max-width:1280px; margin:0 auto; }
    .broadcast-lead { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; margin-bottom:72px; }
    .broadcast-left .section-title { margin-bottom:20px; }
    .broadcast-left p { color:var(--muted); font-size:16px; line-height:1.8; margin-bottom:16px; }
    .broadcast-right { display:grid; grid-template-columns:1fr 1fr; gap:3px; }
    .cam-card {
      background:var(--mid); padding:28px 24px; position:relative; overflow:hidden;
      transition:background 0.2s;
    }
    .cam-card:hover { background:#1f1f1f; }
    .cam-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:var(--gold); opacity:0; transition:opacity 0.2s; }
    .cam-card:hover::before { opacity:1; }
    .cam-icon { font-size:32px; margin-bottom:14px; display:block; }
    .cam-title { font-weight:700; font-size:15px; margin-bottom:6px; }
    .cam-desc { font-size:13px; color:var(--muted); line-height:1.6; }
    .cam-tag { display:inline-block; margin-top:10px; font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--gold); background:var(--gold-dim); padding:3px 10px; border-radius:999px; border:1px solid var(--border-gold); }

    /* BROADCASTPAL SPOTLIGHT */
    .bp-section { background:var(--dark); border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:100px 48px; }
    .bp-inner { max-width:1280px; margin:0 auto; }
    .bp-lead { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }
    .bp-lead-left .section-title { margin-bottom:20px; }
    .bp-lead-left p { color:var(--muted); font-size:16px; line-height:1.8; margin-bottom:16px; }
    .bp-badge { display:inline-flex; align-items:center; gap:8px; border:1px solid var(--border-gold); background:var(--gold-dim); padding:5px 14px; border-radius:999px; font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--gold); margin-bottom:20px; }
    .bp-badge::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--gold); }
    .bp-bullets { display:flex; flex-direction:column; gap:16px; margin-top:8px; }
    .bp-bullet { display:flex; align-items:flex-start; gap:14px; }
    .bp-bullet-icon { font-size:20px; flex-shrink:0; margin-top:2px; }
    .bp-bullet-title { font-weight:700; font-size:15px; margin-bottom:3px; }
    .bp-bullet-desc { font-size:13px; color:var(--muted); line-height:1.6; }
    .console-mockup { background:var(--mid); border:1px solid var(--border); border-radius:8px; overflow:hidden; }
    .console-topbar { background:#0a0a0a; padding:10px 16px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }
    .console-topbar-title { font-family:'Bebas Neue',sans-serif; font-size:14px; letter-spacing:2px; color:var(--gold); }
    .console-live-pill { display:flex; align-items:center; gap:6px; font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#ff4444; }
    .console-live-dot { width:7px; height:7px; border-radius:50%; background:#ff4444; animation:bp-pulse 1.4s infinite; }
    .console-feeds { display:grid; grid-template-columns:repeat(4,1fr); gap:4px; padding:12px; }
    .feed-thumb { aspect-ratio:16/9; border-radius:3px; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:4px; border:2px solid transparent; position:relative; overflow:hidden; }
    .feed-thumb.active { border-color:var(--gold); }
    .feed-thumb-label { font-size:8px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:rgba(255,255,255,0.6); }
    .feed-thumb-icon { font-size:16px; }
    .console-preview { margin:0 12px 12px; aspect-ratio:16/9; border-radius:4px; background:#000; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; border:2px solid var(--gold); }
    .console-preview-label { position:absolute; top:8px; left:8px; font-size:9px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; background:#ff4444; color:#fff; padding:2px 8px; border-radius:2px; }
    .console-preview-icon { font-size:36px; opacity:0.35; }
    .console-controls { padding:10px 12px; border-top:1px solid var(--border); display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .cc-btn { font-size:9px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:6px 12px; border:none; cursor:pointer; border-radius:2px; }
    .cc-btn.cut { background:#cc2200; color:#fff; }
    .cc-btn.fade { background:#555; color:#fff; }
    .cc-btn.mute { background:transparent; color:var(--muted); border:1px solid var(--border); }
    .console-web-badge { margin-left:auto; font-size:9px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:var(--gold); background:var(--gold-dim); padding:4px 10px; border-radius:999px; border:1px solid var(--border-gold); }
    .bp-compare { display:grid; grid-template-columns:1fr 1fr; gap:2px; margin-top:48px; border:1px solid var(--border); border-radius:6px; overflow:hidden; }
    .bp-compare-col { padding:28px 32px; background:var(--mid); }
    .bp-compare-col:first-child { border-right:1px solid var(--border); }
    .bp-compare-title { font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; margin-bottom:20px; }
    .bp-compare-title.red { color:#b84444; }
    .bp-compare-title.gold { color:var(--gold); }
    .bp-compare-list { list-style:none; display:flex; flex-direction:column; gap:10px; }
    .bp-compare-list li { font-size:13px; color:var(--muted-hi); display:flex; align-items:flex-start; gap:10px; line-height:1.5; }
    .bp-compare-list li.bad::before { content:'✕'; color:#b84444; flex-shrink:0; font-size:12px; margin-top:1px; }
    .bp-compare-list li.good::before { content:'✦'; color:var(--gold); flex-shrink:0; font-size:11px; margin-top:2px; }
    @keyframes bp-pulse { 0%,100%{opacity:1;}50%{opacity:0.3;} }
    @media (max-width:900px) {
      .bp-lead { grid-template-columns:1fr; gap:40px; }
      .bp-compare { grid-template-columns:1fr; }
      .bp-compare-col:first-child { border-right:none; border-bottom:1px solid var(--border); }
    }

    /* WHAT'S INCLUDED */
    .included-section { background:var(--dark); border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:100px 48px; }
    .included-inner { max-width:1280px; margin:0 auto; }
    .included-header { max-width:600px; margin-bottom:64px; }
    .included-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:2px; }
    .feature-block { background:var(--mid); padding:36px 28px; border-right:1px solid var(--border); }
    .feature-block:nth-child(3n) { border-right:none; }
    .feature-icon { font-size:28px; margin-bottom:16px; display:block; }
    .feature-title { font-weight:700; font-size:16px; margin-bottom:10px; }
    .feature-desc { font-size:13px; color:var(--muted); line-height:1.75; margin-bottom:16px; }
    .feature-list { list-style:none; display:flex; flex-direction:column; gap:7px; }
    .feature-list li { font-size:12px; color:var(--muted-hi); display:flex; align-items:flex-start; gap:8px; line-height:1.4; }
    .feature-list li::before { content:'→'; color:var(--gold); font-size:11px; flex-shrink:0; margin-top:1px; }

    /* PORTAL SPOTLIGHT */
    .portal-section { padding:100px 48px; max-width:1280px; margin:0 auto; }
    .portal-inner { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:start; }
    .portal-left .section-title { margin-bottom:20px; }
    .portal-left p { color:var(--muted); font-size:16px; line-height:1.8; margin-bottom:16px; }
    .portal-tabs { display:flex; flex-direction:column; gap:2px; margin-top:8px; }
    .portal-tab { border:1px solid var(--border); border-radius:4px; padding:16px 20px; display:flex; gap:14px; align-items:flex-start; transition:background 0.2s; }
    .portal-tab:hover { background:var(--mid); }
    .portal-tab-icon { font-size:18px; flex-shrink:0; margin-top:1px; }
    .portal-tab-title { font-weight:700; font-size:14px; margin-bottom:3px; }
    .portal-tab-desc { font-size:12px; color:var(--muted); line-height:1.5; }
    .portal-preview {
      background:var(--mid); border:1px solid var(--border); border-radius:8px; overflow:hidden;
    }
    .portal-preview-bar { background:#0a0a0a; padding:12px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:12px; }
    .portal-preview-logo { font-family:'Bebas Neue',sans-serif; font-size:18px; letter-spacing:2px; color:var(--gold); }
    .portal-preview-badge { font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; background:#cc2200; color:#fff; padding:2px 8px; border-radius:2px; }
    .portal-preview-tabs { display:flex; border-bottom:1px solid var(--border); overflow-x:auto; }
    .ppt { font-size:10px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:10px 16px; color:var(--muted); border-bottom:2px solid transparent; white-space:nowrap; }
    .ppt.active { color:var(--gold); border-bottom-color:var(--gold); }
    .portal-preview-body { padding:20px; }
    .portal-stat-row { display:grid; grid-template-columns:repeat(3,1fr); gap:2px; margin-bottom:16px; }
    .portal-stat { background:#0a0a0a; padding:14px; text-align:center; }
    .portal-stat-num { font-family:'Bebas Neue',sans-serif; font-size:28px; color:var(--gold); line-height:1; }
    .portal-stat-label { font-size:9px; letter-spacing:1px; text-transform:uppercase; color:var(--muted); margin-top:3px; }
    .portal-ep { background:#0a0a0a; border:1px solid var(--border); padding:12px 14px; margin-bottom:6px; border-radius:2px; }
    .portal-ep-title { font-size:12px; font-weight:600; margin-bottom:6px; }
    .portal-ep-meta { font-size:10px; color:var(--muted); margin-bottom:8px; }
    .portal-ep-btns { display:flex; gap:6px; }
    .peb { font-size:9px; font-weight:700; letter-spacing:1px; text-transform:uppercase; padding:4px 10px; border:none; cursor:pointer; }
    .peb.approve { background:#00cc66; color:#000; }
    .peb.reject { background:transparent; color:#cc2200; border:1px solid #cc2200; }
    .peb.preview { background:transparent; color:var(--muted); border:1px solid var(--border); }

    /* PRICING */
    .pricing-section { background:var(--dark); border-top:1px solid var(--border); padding:100px 48px; }
    .pricing-inner { max-width:900px; margin:0 auto; }
    .pricing-header { text-align:center; margin-bottom:64px; }
    .pricing-header .section-title { margin-bottom:16px; }
    .pricing-header p { color:var(--muted); font-size:16px; max-width:560px; margin:0 auto; line-height:1.75; }

    .pricing-card {
      background:var(--mid); border:1px solid var(--border-gold);
      border-radius:8px; overflow:hidden; margin-bottom:24px;
      position:relative;
    }
    .pricing-card-header { padding:40px 48px 36px; border-bottom:1px solid var(--border); display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:24px; }
    .pricing-card-badge { display:inline-flex; align-items:center; gap:8px; border:1px solid var(--border-gold); background:var(--gold-dim); padding:5px 14px; border-radius:999px; font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--gold); margin-bottom:16px; }
    .pricing-card-badge::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--gold); }
    .pricing-card-name { font-family:'Bebas Neue',sans-serif; font-size:36px; letter-spacing:1px; line-height:1; margin-bottom:8px; }
    .pricing-card-desc { font-size:14px; color:var(--muted); line-height:1.65; max-width:480px; }
    .pricing-price { text-align:right; }
    .pricing-amount { font-family:'Bebas Neue',sans-serif; font-size:72px; color:var(--gold); line-height:0.9; }
    .pricing-period { font-size:13px; color:var(--muted); margin-top:6px; }
    .pricing-note { font-size:11px; color:var(--gold); margin-top:4px; font-weight:600; letter-spacing:0.5px; }

    .pricing-card-body { padding:40px 48px; display:grid; grid-template-columns:1fr 1fr; gap:48px; }
    .pricing-col-title { font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-bottom:20px; }
    .pricing-feature { display:flex; align-items:flex-start; gap:12px; margin-bottom:14px; }
    .pricing-check { color:var(--gold); font-size:13px; flex-shrink:0; margin-top:2px; }
    .pricing-feature-text { font-size:14px; color:var(--muted-hi); line-height:1.5; }
    .pricing-feature-text strong { color:var(--white); font-weight:600; }

    .pricing-card-footer { padding:28px 48px; border-top:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px; background:rgba(201,168,76,0.04); }
    .pricing-footer-note { font-size:13px; color:var(--muted); }
    .pricing-footer-note strong { color:var(--white); }

    /* FOUNDING */
    .founding-callout {
      background:linear-gradient(135deg, rgba(201,168,76,0.08) 0%, rgba(132,22,23,0.08) 100%);
      border:1px solid var(--border-gold); border-radius:8px;
      padding:40px 48px; margin-top:24px; display:flex; align-items:flex-start; gap:36px; flex-wrap:wrap;
    }
    .founding-icon { font-size:48px; flex-shrink:0; }
    .founding-content { flex:1; min-width:260px; }
    .founding-title { font-family:'Bebas Neue',sans-serif; font-size:32px; letter-spacing:1px; margin-bottom:10px; color:var(--gold); }
    .founding-desc { font-size:15px; color:var(--muted-hi); line-height:1.75; margin-bottom:16px; max-width:600px; }
    .founding-perks { display:flex; flex-direction:column; gap:8px; }
    .founding-perk { font-size:13px; color:var(--muted-hi); display:flex; align-items:center; gap:10px; }
    .founding-perk::before { content:'★'; color:var(--gold); font-size:11px; flex-shrink:0; }

    /* STREAMPAL FOOTNOTE */
    .streampal-band {
      border-top:1px solid var(--border); padding:56px 48px;
    }
    .streampal-inner { max-width:1280px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:24px; }
    .streampal-left { max-width:600px; }
    .streampal-tag { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-bottom:10px; display:block; }
    .streampal-title { font-family:'Bebas Neue',sans-serif; font-size:28px; letter-spacing:1px; margin-bottom:10px; }
    .streampal-desc { font-size:14px; color:var(--muted); line-height:1.7; }
    .streampal-price { font-size:13px; color:var(--gold); margin-top:8px; font-weight:600; }

    /* CONTACT */
    .contact-section { background:var(--dark); border-top:1px solid var(--border); padding:100px 48px; }
    .contact-inner { max-width:800px; margin:0 auto; text-align:center; }
    .contact-inner h2 { font-family:'Bebas Neue',sans-serif; font-size:clamp(40px,6vw,72px); letter-spacing:1px; margin-bottom:20px; line-height:1; }
    .contact-inner > p { color:var(--muted); font-size:17px; max-width:560px; margin:0 auto 48px; line-height:1.75; }
    .contact-form { background:var(--mid); border:1px solid var(--border); border-radius:8px; padding:40px; text-align:left; }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px; }
    .form-group { display:flex; flex-direction:column; gap:6px; }
    .form-group label { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--muted); }
    .form-group input, .form-group select, .form-group textarea {
      background:var(--black); border:1px solid var(--border); color:var(--white);
      font-family:'DM Sans',sans-serif; font-size:14px; padding:12px 16px;
      outline:none; border-radius:2px; transition:border-color 0.2s; width:100%;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color:var(--gold); }
    .form-group textarea { resize:vertical; min-height:100px; }
    .form-group select option { background:var(--dark); }
    .form-submit { width:100%; margin-top:8px; }
    .form-success { display:none; text-align:center; padding:32px; }
    .form-success-icon { font-size:48px; margin-bottom:16px; }
    .form-success h3 { font-family:'Bebas Neue',sans-serif; font-size:28px; letter-spacing:1px; margin-bottom:8px; color:var(--gold); }
    .form-success p { font-size:14px; color:var(--muted); }

    /* FOOTER */
    footer { background:var(--black); border-top:1px solid var(--border); padding:40px 48px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; }
    .footer-logo { font-family:'Bebas Neue',sans-serif; font-size:20px; letter-spacing:2px; color:var(--muted); }
    .footer-logo span { color:var(--gold); }
